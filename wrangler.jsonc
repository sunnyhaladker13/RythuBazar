{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rythu-bazar",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // Public address. Wrangler creates the DNS record in the sunnyhaladker.my zone. workers.dev stays
  // on so links already shared there keep working (they redirect once SITE_ORIGIN is set).
  "routes": [{ "pattern": "rythu.sunnyhaladker.my", "custom_domain": true }],
  "workers_dev": true,

  // public/ holds the static files (styles, script, share image). The Worker renders every page
  // (src/site.ts) and answers /api/*; anything else that isn't a file gets its 404 page.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/vegetables", "/vegetables/*", "/branches", "/branches/*", "/sitemap.xml", "/robots.txt"]
  },

  // Per-IP limit on /api/* (src/index.ts). Approximate and per Cloudflare location. Generous
  // because Indian mobile carriers put many users behind one IP; it only stops runaway scripts.
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rythu-bazar",
      "database_id": "f7257157-5884-48d2-92ea-f32d64e89517",
      "migrations_dir": "migrations"
    }
  ],

  // Every 5 min, 05:30–16:25 IST (some bazars post before 07:30). Each tick does only the work that is due and
  // fits the free-plan budget (50 subrequests, 10 ms CPU), so most ticks are no-ops.
  "triggers": { "crons": ["*/5 0-10 * * *"] },

  "vars": {
    // Workers can't fetch() a bare IP (error 1003); sslip.io resolves this name to
    // 183.82.5.184 and the IIS server answers any Host. Swap for your own A record if preferred.
    "RBZ_ORIGIN": "http://183-82-5-184.sslip.io",
    // Max outbound fetches per tick (incl. retries). D1 uses ≤ 11 more; free limit is 50.
    "FETCH_BUDGET": "35",
    "REQUEST_DELAY_MS": "250",
    // Market not reported today: re-check this often.
    "ACTIVE_INTERVAL_MIN": "30",
    // Market already reported today: re-check for revisions this often.
    "RECHECK_INTERVAL_MIN": "180",
    // Re-read each district's market list (and empty districts) this often.
    "DISCOVERY_INTERVAL_MIN": "1440",
    // The site's public address for canonical links and the sitemap. Pages asked for on any other
    // host (workers.dev) 302 there. Empty: each request's own host.
    "SITE_ORIGIN": "https://rythu.sunnyhaladker.my"
  }
  // Optional secret enabling POST /api/admin/scrape: `npx wrangler secret put ADMIN_TOKEN`
}
